import re
customer_name=input("Enter your name:-")
mobile_recharge={
    "airtel":{
        "199":28,
        "299":28,
        "399":56,
        "599":84,   
        "999":112
    },
    "vi":{
        "199":28,
        "299":28,
        "399":56,
        "599":84,   
        "999":112
    },
    "jio":{
        "199":28,
        "299":28,
        "399":56,
        "599":84,   
        "999":112
    },
    "bsnl":{
        "199":28,
        "299":28,
        "399":56,
        "599":84,   
        "999":112
    }
}
mobile_number=int(input("Enter your mobile number:-"))
num_of_recharge=int(input("Enter the number of recharge u want to do:-"))
match=re.fullmatch(r'\b\d{10}\b',str(mobile_number))
price=0
final_recharge_amount=0
if(match):
    print("valid mobile number")
    for i in range(0,num_of_recharge):
        recharge_type=input("Enter the type of recharge u want to do(prepaid or postpaid):-")
        mobile_sim=input("Enter your mobile sim(airtel,vi,jio,bsnl):-")
        if(mobile_sim in mobile_recharge):
            print("valid sim")
            recharge_amount=input("Enter the amount of recharge u want to do:-")
            if(recharge_type=="prepaid"):
                if(recharge_amount in mobile_recharge[mobile_sim]):
                    price+=int(recharge_amount)
                    print("the validity of your recharge is:-",mobile_recharge[mobile_sim][recharge_amount],"days")
                else:
                    print("invalid recharge amount")
                    quit()
            elif(recharge_type=="postpaid"):
                if(recharge_amount in mobile_recharge[mobile_sim]):
                    price+=int(recharge_amount)+99
                    print("the validity of your recharge is:-",mobile_recharge[mobile_sim][recharge_amount],"days")
                else:
                    print("invalid recharge amount")
                    quit()
            else:
                print("invalid recharge type")
                quit()
            final_recharge_amount+=price
            price=0
    if final_recharge_amount>1500:
        discount=0.08*final_recharge_amount
        final_recharge_amount=final_recharge_amount-discount
        print("discount given:-",discount)
    else:
        print("no discount given")
    gst=0.18*final_recharge_amount
    final_price=final_recharge_amount+gst
    print(customer_name)
    print("mobile number:-",mobile_number)
    print("number of recharge done:-",num_of_recharge)
    print("final price:-",final_price)
else:
    print("invalid mobile number")
    exit()